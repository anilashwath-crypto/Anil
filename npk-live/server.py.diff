+def lan_ip():
+    """Best-guess LAN address to print for phones. No packet is actually sent -
+    connect() on a UDP socket just picks the interface that would be used."""
+    import socket
+    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    try:
+        s.connect(("8.8.8.8", 80))
+        return s.getsockname()[0]
+    except Exception:
+        return "your-lan-ip"
+    finally:
+        s.close()
+
